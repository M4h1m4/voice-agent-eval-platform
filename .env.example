# Only needed to RECORD new LLM runs. Reviewing the submission needs neither.
#
#   LLM_MODE=replay  (default)  serve every model call from cache/llm/ — no network
#   LLM_MODE=live               call OpenAI and record each response into cache/llm/
#
# The default is replay on purpose: a missing LLM_MODE must never mean "spend money".

OPENAI_API_KEY=
# Mid-tier by default — see decisions.md D19 for why that is a deliberate choice.
OPENAI_MODEL=gpt-4o-mini
LLM_MODE=replay
